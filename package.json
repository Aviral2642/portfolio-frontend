{
  "name": "portfolio-client",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "framer-motion": "^10.16.4",
    "gsap": "^3.14.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3",
    "styled-components": "^6.5.3",
    "three": "^0.180.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000",
    "preview:local": "node scripts/preview-local.mjs",
    "build": "npm run lint && vite build",
    "build:review": "npm run lint && vite build --mode review",
    "lint": "eslint src/designer src/experience src/data src/App.js src/index.js src/pages/Exploits.js src/styles scripts/*.mjs vite.config.mjs",
    "test": "vitest run",
    "sync-exploits": "node scripts/sync-exploits.js",
    "predeploy": "npm test && npm run build",
    "deploy": "gh-pages -d build --nojekyll",
    "postbuild": "node scripts/finalize-build.mjs"
  },
  "homepage": "https://www.aviralsrivastava.tech",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
